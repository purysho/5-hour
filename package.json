{
  "name": "driftless",
  "version": "0.0.0",
  "private": true,
  "description": "Detects breaking changes in upstream APIs and opens the fixing PR in downstream codebases.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "db:reset": "node --experimental-strip-types scripts/migrate.ts --reset",
    "start:worker": "node --experimental-strip-types src/main/run-worker.ts",
    "start:server": "node --experimental-strip-types src/main/run-server.ts",
    "preflight": "node --experimental-strip-types scripts/preflight.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "pg": "^8.13.1",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "vitest": "^2.1.8"
  }
}
