# Driftless configuration.
#
# Copy to `.env` and fill in. `.env` is gitignored; this file must never
# contain a real value — not "an example with the real one substituted in",
# which is how credentials reach version control.
#
# Every setting is validated at startup and every problem is reported at once,
# so a wrong value fails the deploy rather than the first request under load.
# `pnpm preflight` checks the parts config cannot: that the private key
# actually belongs to the App, that the permission manifest has not been
# widened, and that the two database roles are separate.

NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────────────
#
# Two login roles, never one. `driftless_app_login` is a member of
# driftless_app and has row-level security applied; `driftless_worker_login` is
# a member of driftless_admin and is used for dequeue and the two
# minimal-disclosure lookups.
#
# No login role may hold both. Postgres ORs together the policies of every role
# you belong to, so combining them grants cross-tenant visibility with no error
# and nothing to see in review (ADR-0010).

DATABASE_URL=postgresql://driftless_app_login:PASSWORD@localhost:5432/driftless
PLATFORM_DATABASE_URL=postgresql://driftless_worker_login:PASSWORD@localhost:5432/driftless

# The operator scripts (db:status, db:approve, db:watch, db:replan, db:provider)
# run on the migration connection. The tables they touch are RLS-confined to a
# tenant, and neither role above can reach them from a CLI: the app role needs
# a provider context nothing here can supply, and driftless_admin's
# cross-tenant policies cover only `job` and `job_step`.
#
# Unset, they fall back to DATABASE_URL — correct in development, where this is
# all one superuser, and quietly wrong in production, where RLS filters rather
# than raising and the scripts report an empty system instead of an error.
ADMIN_DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/driftless

# ── GitHub App ──────────────────────────────────────────────────────────────
#
# The App ID is not a secret — it appears in every JWT the App issues. The
# private key is the crown jewel: it mints installation tokens for every
# installation, so holding it is equivalent to holding durable write access to
# every repository the App is installed on.

GITHUB_APP_ID=

# openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# Exactly one of the next two, never both — otherwise which key signs is
# decided by code order rather than by you.
#
# KMS is the destination (ADR-0002 §2): the key cannot be exported, and the
# process can only request signatures.
#GITHUB_SIGNING_KEY_ID=arn:aws:kms:eu-west-1:000000000000:key/...
#
# A file is the bounded interim position (ADR-0012), acceptable ONLY while
# acting on repositories you own. Mode 600, outside the repository. The path,
# never the contents — `GITHUB_PRIVATE_KEY` being set at all is a startup
# failure, because a key that has been in an environment variable is already
# exposed.
GITHUB_PRIVATE_KEY_FILE=/home/you/.driftless/github-app.pem

# Required in production alongside GITHUB_PRIVATE_KEY_FILE. Deliberately
# unpleasant to type, so it cannot become the default by accident.
#DRIFTLESS_ACCEPT_IN_PROCESS_SIGNING_KEY=yes-i-know-this-is-not-a-kms

# Windows only. Node synthesises stat().mode from the read-only attribute
# there, so the permission check cannot see the ACL that actually governs
# access. Restrict the file first:
#
#   icacls "%USERPROFILE%\.driftless\github-app.pem" /inheritance:r /grant:r "%USERNAME%:(R)"
#
# then set this to say you did. WSL avoids it — the check is real there.
#DRIFTLESS_ACCEPT_UNVERIFIED_KEY_PERMISSIONS=windows-acl-checked-by-hand

# ── Public origin ───────────────────────────────────────────────────────────
#
# Opt-out links are printed into pull request bodies on public repositories, so
# this must be https in production — an http origin is a downgrade we would be
# publishing ourselves.

PUBLIC_ORIGIN=http://localhost:8080

# ── Migration generation ────────────────────────────────────────────────────
#
# Optional. The server never generates a migration, and a worker running only
# detect-changes does not either. Without it the worker declines to register
# migrate-repository and says so at startup.

#ANTHROPIC_API_KEY=

# ── Tuning ──────────────────────────────────────────────────────────────────
#
# SCHEDULER_INTERVAL_MS is how often the scheduler looks for packages due a
# sweep — not how often a package is swept, which is per-package in
# watched_package.sweep_interval_seconds.

#PORT=8080
#WORKER_CONCURRENCY=4
#WORKER_POLL_INTERVAL_MS=1000
#SHUTDOWN_GRACE_MS=30000
#SCHEDULER_INTERVAL_MS=60000

# ── Billing ─────────────────────────────────────────────────────────────────
#
# All of these or none of them. A secret key with no webhook secret produces a
# deployment that can charge a customer and never hear that it did — they are
# billed, never provisioned, and nothing on our side reports a problem. The
# config loader refuses to start on a partial configuration for that reason.
#
# Leaving the whole block unset is a valid configuration: a self-hosted or
# single-tenant deployment enrols through DEFAULT_PROVIDER_SLUG and never
# shows a price. The /pricing, /checkout, /welcome and /webhooks/stripe routes
# are then not mounted at all.

# The Stripe secret key. A restricted key (rk_) is preferred over a full
# secret key: this process needs `checkout_session:write`,
# `billing_portal_session:write` and nothing else, and a full key in a
# public-facing process is a key that can issue refunds.
STRIPE_SECRET_KEY=rk_live_REPLACE_ME

# The signing secret of the webhook endpoint, from the Stripe dashboard —
# NOT the endpoint id. Pasting the endpoint id here fails every signature,
# silently, forever; the `whsec_` prefix is checked at startup for that reason.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Price ids, one per plan in src/billing/plans.ts. These differ between test
# and live mode, which is why they are configuration rather than source: the
# mode that is not in the source is the one that breaks in production.
STRIPE_PRICE_STARTER=price_REPLACE_ME
STRIPE_PRICE_TEAM=price_REPLACE_ME
STRIPE_PRICE_SCALE=price_REPLACE_ME

# A THIRD login role, member of driftless_billing and nothing else.
#
# Not DATABASE_URL: the application role cannot execute provision_subscription
# at all (migration 012), so pointing this at it fails on the first paying
# customer. Not a role that also holds driftless_app or driftless_admin:
# Postgres ORs the policies of every role you hold, so a combined role gains
# cross-tenant visibility with no error and nothing to see in review
# (ADR-0010). Startup refuses if this equals DATABASE_URL.
BILLING_DATABASE_URL=postgresql://driftless_billing_login:PASSWORD@localhost:5432/driftless

# Where a customer is sent after paying, to install the GitHub App. Found on
# the App's page as "Install App"; typically
# https://github.com/apps/<app-slug>/installations/new
GITHUB_APP_INSTALL_URL=https://github.com/apps/REPLACE_ME/installations/new

# Stripe's hosted customer portal login page (Stripe → Settings → Billing →
# Customer portal → "login page"). A URL rather than a session minted per
# request: minting one requires knowing which customer is asking, and this
# process has no authenticated surface to learn that from. Stripe's page takes
# an email and mails a link, which also avoids an endpoint that would confirm
# whether a given address is a customer.
STRIPE_PORTAL_URL=https://billing.stripe.com/p/login/REPLACE_ME
